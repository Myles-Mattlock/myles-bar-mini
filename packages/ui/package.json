{
  "name": "@myles-zebar/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./fonts.css": "./src/fonts.css",
    "./index.css": "./dist/index.css",
    "./theme.css": "./src/theme.css"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && tailwindcss -i ./src/index.css -o ./dist/index.css",
    "check-types": "tsc --noEmit",
    "dev": "tailwindcss -i ./src/index.css -o ./dist/index.css --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@myles-zebar/config": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "react": "catalog:",
    "react-colorful": "^5.8.1",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@myles-zebar/tailwind": "workspace:*",
    "@myles-zebar/typescript": "workspace:*",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.4.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.5.4",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.3"
  }
}
