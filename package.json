{
  "name": "myles-bar-mini",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "syncpack": "15.3.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm --filter @myles-zebar/ui build && pnpm --filter \"@myles-zebar/*\" --filter \"!@myles-zebar/ui\" build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,html,yaml,vue,svelte,graphql}",
    "check-format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,html,yaml,vue,svelte,graphql}\"",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix"
  },
  "dependencies": {
    "react-compiler-runtime": "catalog:",
    "use-debounce": "^10.1.1"
  }
}
