{
  "$schema": "https://github.com",
  "name": "Myles Bar Mini",
  "version": "1.0.0",
  "description": "Fully featured topbar using React+Vite, Tailwind & Framer Motion. ",
  "tags": [],
  "previewImages": [
    "resources/preview-image-1.png",
    "resources/preview-image-2.png",
    "resources/preview-image-3.png"
  ],
  "repositoryUrl": "https://github.com",
  "widgets": [
    {
      "name": "main",
      "htmlPath": "./widgets/main/dist/index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/main/dist/index.html",
        "widgets/main/dist/assets/**",
        "widgets/main/dist/config.json",
        "widgets/main/dist/geistMono/**",
        "widgets/main/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "bottom_right",
          "offsetX": "0px",
          "offsetY": "-48px",
          "width": "327px",
          "height": "28px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "config-widget",
      "htmlPath": "./widgets/config-widget/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": true,
      "focused": true,
      "resizable": true,
      "transparent": true,
      "includeFiles": [
        "widgets/config-widget/dist/index.html",
        "widgets/config-widget/dist/assets/**",
        "widgets/config/dist/config-widget.json",
        "widgets/config/dist/geistMono/**",
        "widgets/config-widget/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "center",
          "offsetX": "0px",
          "offsetY": "4px",
          "width": "1100px",
          "height": "720px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
